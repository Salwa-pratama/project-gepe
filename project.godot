; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectGEPE"
run/main_scene="uid://rg2suep1saas"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*uid://dexch3q1uoqti"
DialogueManager="*uid://c3rodes2l3gxb"
SoundManager="*res://sound_manager.tscn"

[dialogue_manager]

runtime/balloon_path="res://dialogue_ballons/balloon.tscn"

[display]

window/size/viewport_width=1168
window/size/viewport_height=656

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogues/main.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
